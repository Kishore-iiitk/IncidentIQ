# ==============================================================================
# IncidentIQ - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file with secrets into version control.

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=IncidentIQ
APP_VERSION=0.1.0
SECRET_KEY=generate-a-secure-random-secret-key-for-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
RELOAD=true

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incidentiq
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incidentiq

# File Storage & Evidence Upload Limits
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.log,.txt,.csv,.json,.png,.jpg,.jpeg,.webp,.mp3,.wav,.m4a,.eml

# AI & LLM Services (Configure your preferred provider; fallback to local mock when unset)
AI_PROVIDER=mock
# Options: mock, openai, anthropic, gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=mock
# Options: mock, openai, huggingface
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Audio / Voice Transcription
TRANSCRIPTION_PROVIDER=mock
# Options: mock, whisper-local, openai-whisper

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api
